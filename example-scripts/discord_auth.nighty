// Discord Auth Bot using NightyScript and SQLite3
// Requires: nightyscript, discord.py, sqlite3

import discord
import sqlite3
import random
import string

TOKEN = 'YOUR_BOT_TOKEN_HERE' // <-- Replace with your bot token
GUILD_ID = 123456789012345678 // <-- Replace with your server's ID
VERIFIED_ROLE = 'Verified'
UNVERIFIED_ROLE = 'Unverified'
VERIFICATION_CHANNEL = 'verification'
DB_PATH = 'discord_auth.sqlite3'

// --- Database Setup ---
conn = sqlite3.connect(DB_PATH)
c = conn.cursor()
c.execute('''CREATE TABLE IF NOT EXISTS keys (key TEXT PRIMARY KEY, used_by TEXT)''')
conn.commit()

// --- Bot Setup ---
client = discord.Client(intents=discord.Intents.all())

// --- Helper Functions ---
def gen_key(length=8):
    return ''.join(random.choices(string.ascii_uppercase + string.digits, k=length))

def add_key(key):
    c.execute('INSERT OR IGNORE INTO keys (key, used_by) VALUES (?, NULL)', (key,))
    conn.commit()

def use_key(key, user_id):
    c.execute('UPDATE keys SET used_by=? WHERE key=? AND used_by IS NULL', (str(user_id), key))
    conn.commit()
    return c.rowcount > 0

def is_admin(member):
    return any(role.permissions.administrator for role in member.roles)

// --- On Ready: Ensure Channel and Roles ---
@client.event
async def on_ready():
    print(f'Logged in as {client.user}')
    guild = client.get_guild(GUILD_ID)
    // Ensure roles
    roles = {role.name: role for role in guild.roles}
    if VERIFIED_ROLE not in roles:
        await guild.create_role(name=VERIFIED_ROLE)
    if UNVERIFIED_ROLE not in roles:
        await guild.create_role(name=UNVERIFIED_ROLE)
    // Ensure channel
    channel = discord.utils.get(guild.channels, name=VERIFICATION_CHANNEL)
    if not channel:
        overwrites = {
            guild.default_role: discord.PermissionOverwrite(view_channel=False),
            roles[UNVERIFIED_ROLE]: discord.PermissionOverwrite(view_channel=True),
        }
        admin_roles = [role for role in guild.roles if role.permissions.administrator]
        for role in admin_roles:
            overwrites[role] = discord.PermissionOverwrite(view_channel=True)
        channel = await guild.create_text_channel(VERIFICATION_CHANNEL, overwrites=overwrites)
    print('Setup complete.')

// --- On Message: Verification and Admin Commands ---
@client.event
async def on_message(message):
    if message.author.bot:
        return
    guild = message.guild
    member = guild.get_member(message.author.id)
    roles = {role.name: role for role in guild.roles}
    // Only handle in verification channel
    if message.channel.name != VERIFICATION_CHANNEL:
        return
    // !verify <key>
    if message.content.startswith('!verify '):
        key = message.content.split(' ', 1)[1].strip()
        if use_key(key, message.author.id):
            await member.add_roles(roles[VERIFIED_ROLE])
            if UNVERIFIED_ROLE in roles:
                await member.remove_roles(roles[UNVERIFIED_ROLE])
            await message.channel.send(f'✅ {member.mention} verified!')
        else:
            await message.channel.send('❌ Invalid or already used key.')
    // !genkey (admin only)
    elif message.content.startswith('!genkey') and is_admin(member):
        new_key = gen_key()
        add_key(new_key)
        await message.channel.send(f'New verification key: `{new_key}`')

client.run(TOKEN)